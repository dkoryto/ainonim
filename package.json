{
  "name": "ainonim",
  "description": "Maskowanie polskich danych osobowych w czatach AI i formularzach (polanon + Pyodide).",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "measure": "wxt build && AINONIM_MEASURE=1 playwright test measure"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "pyodide": "314.0.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "wxt": "0.21.5"
  }
}
