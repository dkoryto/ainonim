{
  "name": "ainonim",
  "description": "Maskowanie polskich danych osobowych w czatach AI i formularzach (polanon + Pyodide).",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && node scripts/check-production-build.js",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip && node scripts/check-production-build.js",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:e2e && playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "measure": "npm run build:e2e && AINONIM_MEASURE=1 playwright test measure",
    "screenshots": "npm run build:e2e && node scripts/screenshots.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lexical/history": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "lexical": "0.53.0",
    "prettier": "3.10.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.9",
    "pyodide": "314.0.8",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "wxt": "0.21.5"
  },
  "overrides": {
    "@vitest/istanbul-lib-coverage": "2.1.0",
    "@vitest/istanbul-lib-report": "2.1.0",
    "ast-v8-to-istanbul": "1.0.7"
  }
}
